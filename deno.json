{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "@types/react",
    "lib": [
      "deno.ns",
      "deno.unstable",
      "dom",
      "dom.iterable",
      "esnext"
    ]
  },
  "unstable": [
    "bundle"
  ],
  "nodeModulesDir": "auto",
  "exclude": [
    "coverage/",
    "data/",
    "logs/",
    ".secrets/"
  ],
  "tasks": {
    "start": "deno run --allow-net --allow-read --allow-write=data --allow-env --allow-run src/server/main.ts",
    "dev": "deno run --watch=src/,tooling/ --allow-net --allow-read --allow-write=data --allow-env --allow-run src/server/main.ts",
    "check": "deno check src/ tooling/ bin/",
    "fmt": "deno fmt",
    "lint": "deno fmt --check && deno lint",
    "test": "deno test --allow-read --allow-write --allow-run --coverage --clean --coverage-threshold=90",
    "build": "deno task check && deno task lint && deno task test",
    "setup-certs": "deno run --allow-read --allow-write --allow-run --allow-env bin/setup-certs.ts",
    "install-service": "deno run --allow-read --allow-write --allow-run --allow-env bin/install-service.ts",
    "uninstall-service": "deno run --allow-read --allow-write --allow-run --allow-env bin/uninstall-service.ts"
  },
  "fmt": {
    "lineWidth": 100
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended",
        "react",
        "jsx"
      ]
    }
  },
  "imports": {
    "@chakra-ui/react": "npm:@chakra-ui/react@3.37.0",
    "@emotion/react": "npm:@emotion/react@^11.14.0",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/encoding": "jsr:@std/encoding@^1.0.11",
    "@types/react": "npm:@types/react@^19.2.0",
    "@types/react-dom": "npm:@types/react-dom@^19.2.0",
    "effect": "npm:effect@3.22.4",
    "react": "npm:react@^19.2.0",
    "react/": "npm:/react@^19.2.0/",
    "react-dom": "npm:react-dom@^19.2.0",
    "react-dom/": "npm:/react-dom@^19.2.0/",
    "react-icons/": "npm:/react-icons@^5.5.0/"
  }
}
