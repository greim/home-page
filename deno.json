{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "@types/react",
    "lib": [
      "deno.ns",
      "deno.unstable",
      "dom",
      "dom.iterable",
      "esnext"
    ]
  },
  "unstable": [
    "bundle"
  ],
  "nodeModulesDir": "auto",
  "exclude": [
    "coverage/",
    "data/",
    "dist/",
    "logs/",
    ".secrets/",
    "scratch-docs/"
  ],
  "tasks": {
    "start": "deno run --allow-net --allow-read --allow-write=data --allow-env --allow-run src/server/main.ts",
    "dev": "deno run --watch=src/,tooling/ --allow-net --allow-read --allow-write=data --allow-env --allow-run src/server/main.ts",
    "start-assistant": "deno run --allow-net --allow-read --allow-write=data --allow-env --allow-run --allow-sys src/server/assistant-main.ts",
    "check": "deno check src/ tooling/ bin/",
    "fmt": "deno fmt",
    "lint": "deno fmt --check && deno lint",
    "test": "deno test --allow-read --allow-write --allow-run --allow-env --allow-sys --allow-net=127.0.0.1 --coverage --clean --coverage-threshold=90",
    "build-widgets": "deno run --allow-read --allow-write=dist --allow-env bin/build-widgets.ts",
    "build": "deno task check && deno task lint && deno task test && deno task build-widgets",
    "setup": "deno run --allow-read --allow-write --allow-run --allow-env --allow-sys=uid --allow-net=127.0.0.1 bin/setup.ts",
    "uninstall-service": "deno run --allow-read --allow-write --allow-run --allow-env --allow-sys=uid bin/uninstall-service.ts",
    "restart-service": "deno run --allow-read --allow-run --allow-env --allow-sys=uid --allow-net=127.0.0.1 bin/restart-service.ts"
  },
  "fmt": {
    "lineWidth": 100
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended",
        "react",
        "jsx"
      ]
    }
  },
  "imports": {
    "@anthropic-ai/claude-agent-sdk": "npm:@anthropic-ai/claude-agent-sdk@0.3.319",
    "@chakra-ui/react": "npm:@chakra-ui/react@3.37.0",
    "@emotion/cache": "npm:@emotion/cache@^11.14.0",
    "@emotion/react": "npm:@emotion/react@^11.14.0",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/encoding": "jsr:@std/encoding@^1.0.11",
    "@types/react": "npm:@types/react@^19.2.0",
    "@types/react-dom": "npm:@types/react-dom@^19.2.0",
    "effect": "npm:effect@3.22.4",
    "modern-screenshot": "npm:modern-screenshot@4.7.0",
    "react": "npm:react@^19.2.0",
    "react/": "npm:/react@^19.2.0/",
    "react-dom": "npm:react-dom@^19.2.0",
    "react-dom/": "npm:/react-dom@^19.2.0/",
    "react-icons/": "npm:/react-icons@^5.5.0/",
    "react-markdown": "npm:react-markdown@10.1.0",
    "remark-gfm": "npm:remark-gfm@4.0.1",
    "remark-parse": "npm:remark-parse@11.0.0",
    "remark-rehype": "npm:remark-rehype@11.1.2",
    "unified": "npm:unified@11.0.5",
    "hast-util-to-html": "npm:hast-util-to-html@9.0.5",
    "hast-util-to-jsx-runtime": "npm:hast-util-to-jsx-runtime@2.3.7",
    "hast": "npm:@types/hast@3.0.5",
    "diff": "npm:diff@8.0.4",
    "fast-xml-parser": "npm:fast-xml-parser@5.11.2",
    "sanitize-html": "npm:sanitize-html@2.18.1",
    "@types/sanitize-html": "npm:@types/sanitize-html@2.16.1"
  }
}
